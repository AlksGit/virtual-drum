# Virtual Drum stick options.

config VDRUM_STICK_ID
	int "Stick id (0 = left, 1 = right)"
	range 0 1
	default 0
	help
	  Written in every packet header and selects the ESB pipe. Build the right stick with
	  -DCONFIG_VDRUM_STICK_ID=1.

config VDRUM_STREAM_RAW
	bool "Stream raw IMU samples (RAW packets)"
	default y
	help
	  Phase 0 recorder: every IMU sample goes out in RAW packets, about 30 % of the air time with
	  two sticks. Hits are sent either way. Build with -DCONFIG_VDRUM_STREAM_RAW=n to play: only
	  HIT and STATUS packets go out, so a hit never waits behind RAW packets.

config VDRUM_SLEEP_AFTER_S
	int "Power off after this long at rest, in seconds (0 = never)"
	range 0 3600
	default 0 if VDRUM_STREAM_RAW
	default 10
	help
	  The stick has no power switch: after this long without moving (the rest test of the gyro
	  bias calibration), it enters System OFF and wakes on a sharp knock. Off in the recorder build,
	  whose rest recordings last 10 minutes.

config VDRUM_SLEEP_WITHOUT_HIT_S
	int "Power off after this long without a hit, in seconds (0 = never)"
	range 0 3600
	default 0 if VDRUM_STREAM_RAW
	default 300
	help
	  Safety net for the battery: power off even if the rest test never sees the stick at rest
	  (on 2026-11-09 a wrong FIFO order made the left stick look always moving, and it never
	  slept). Woken by a sharp knock, like after a rest.

# ST's LSM6DS3TR-C driver from hal_st (hidden symbols, selected here).
config VDRUM_STICK_IMU_DRIVER
	bool
	default y
	select HAS_STMEMSC
	select USE_STDC_LSM6DS3TR_C

source "Kconfig.zephyr"
